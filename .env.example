# Copy to .env and adjust. Never commit .env.

# ---- LLM (leave LLM_API_KEY empty to run in deterministic DEMO mode) ----
# demo | openai | gemini | groq
LLM_PROVIDER=demo
LLM_API_KEY=
# Optional. Any OpenAI-compatible endpoint (OpenAI, Azure-compatible gateways, Ollama, vLLM, ...).
# For gemini the default is https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
# Defaults: gpt-4o-mini (openai), gemini-2.0-flash (gemini), openai/gpt-oss-120b (groq)
LLM_MODEL=

# ---- Agent behaviour ----
# Minimum tool risk that needs human approval: none | low | medium | high
APPROVAL_THRESHOLD=medium
MAX_RETRIES=3
# Backoff delay = base * 2^(attempt-1) seconds
RETRY_BACKOFF_BASE=0.5

# ---- Storage (any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db) ----
# DATABASE_URL=sqlite:///./data/centralign.db
# CHECKPOINT_DB_PATH=./data/checkpoints.db
# DATA_DIR=./data

# ---- Browser ("computer use") tools ----
BROWSER_TOOLS_ENABLED=true
BROWSER_HEADLESS=true
# Where the agent's browser finds the CRM web UI
FRONTEND_URL=http://localhost:5173
